# Copy this file to ".env" and fill in your own MongoDB Atlas credentials.
# Never commit the real .env file (it is already in .gitignore).

# MongoDB Atlas connection string.
# Get it from Atlas: Connect -> Drivers -> connection string.
# Replace <username>, <password>, and <cluster> with your own values.
# The database name (campusLostFound) can stay as-is or be changed.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusLostFound?retryWrites=true&w=majority

# Port the Express server listens on
PORT=3000
